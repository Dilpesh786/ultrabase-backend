{
  "preset": "node-style-guide",
  "fileExtensions": [ ".js" ],
  "esnext": true,
  "requireCurlyBraces": [
    "if",
    "else",
    "for",
    "while",
    "do",
    "try",
    "catch"
  ],
  "requireSpaceAfterKeywords": [
    "if",
    "else",
    "for",
    "while",
    "do",
    "switch",
    "return",
    "try",
    "catch"
  ],
  "disallowSpacesInsideParentheses": true,
  "maximumLineLength": 120
}
